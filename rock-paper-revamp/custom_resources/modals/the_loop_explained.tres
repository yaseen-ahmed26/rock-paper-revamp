script = ExtResource("1_3w3sh")
modal_id = "the_loop_explained"
title = "The Loop"
primary_text = "The Loop is pure randomized chaos! 20 rounds with a new gamemode every 4, new opponent every 5 and up to 15 modiifers at once?!"
secondary_text = "Sadly, you don't have enough modifiers unlocked to play. That's a shame, but I guess it's for the best."
continue_btn_text = "*Sigh*"
